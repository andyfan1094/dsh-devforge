{
  "--background": "oklch(0.13 0 0)",
  "--foreground": "oklch(1 0 0)",
  "--card": "oklch(0.17 0 0)",
  "--card-foreground": "oklch(1 0 0)",
  "--popover": "oklch(0.21 0 0)",
  "--popover-foreground": "oklch(1 0 0)",
  "--primary": "oklch(0.27 0 0)",
  "--primary-foreground": "oklch(1 0 0)",
  "--secondary": "oklch(0.17 0 0)",
  "--secondary-foreground": "oklch(0.78 0 0)",
  "--muted": "oklch(0.17 0 0)",
  "--muted-foreground": "oklch(0.62 0 0)",
  "--accent": "oklch(0.23 0 0)",
  "--accent-foreground": "oklch(1 0 0)",
  "--destructive": "oklch(0.62 0.21 25)",
  "--destructive-foreground": "oklch(0.97 0 0)",
  "--border": "oklch(1 0 0 / 0.08)",
  "--input": "oklch(0.17 0 0)",
  "--ring": "oklch(1 0 0 / 0.18)",
  "--radius": "0.75rem",
  "--shadow-pill": "0 0 0 0.5px rgba(255, 255, 255, 0.08),\n    inset 0 1px 0 rgba(255, 255, 255, 0.08),\n    0 1px 2px rgba(0, 0, 0, 0.4),\n    0 4px 12px rgba(0, 0, 0, 0.25)",
  "--shadow-pill-hover": "0 0 0 0.5px rgba(255, 255, 255, 0.12),\n    inset 0 1px 0 rgba(255, 255, 255, 0.12),\n    0 2px 4px rgba(0, 0, 0, 0.45),\n    0 6px 16px rgba(0, 0, 0, 0.3)",
  "--shadow-xs": "inset 0 1px 0 rgba(255, 255, 255, 0.04),\n    0 1px 1px rgba(0, 0, 0, 0.35)",
  "--shadow-sm": "0 0 0 0.5px rgba(255, 255, 255, 0.06),\n    inset 0 1px 0 rgba(255, 255, 255, 0.06),\n    0 1px 2px rgba(0, 0, 0, 0.4),\n    0 2px 4px rgba(0, 0, 0, 0.2)",
  "--shadow-md": "0 0 0 0.5px rgba(255, 255, 255, 0.08),\n    inset 0 1px 0 rgba(255, 255, 255, 0.08),\n    0 2px 4px rgba(0, 0, 0, 0.5),\n    0 4px 12px rgba(0, 0, 0, 0.25)",
  "--shadow-lg": "0 0 0 0.5px rgba(255, 255, 255, 0.1),\n    inset 0 1px 0 rgba(255, 255, 255, 0.1),\n    0 6px 12px rgba(0, 0, 0, 0.55),\n    0 12px 24px rgba(0, 0, 0, 0.35)",
  "--shadow-xl": "0 0 0 0.5px rgba(255, 255, 255, 0.12),\n    inset 0 1px 0 rgba(255, 255, 255, 0.14),\n    0 12px 24px rgba(0, 0, 0, 0.65),\n    0 24px 48px rgba(0, 0, 0, 0.4)",
  "--shadow-inset": "inset 0 1px 2px rgba(0, 0, 0, 0.6),\n    inset 0 -1px 0 rgba(255, 255, 255, 0.03)",
  "--shadow-inset-deep": "inset 0 2px 4px rgba(0, 0, 0, 0.7),\n    inset 0 -1px 0 rgba(255, 255, 255, 0.04)",
  "--pill-gradient": "linear-gradient(180deg, oklch(0.27 0 0) 0%, oklch(0.21 0 0) 100%)",
  "--pill-gradient-hover": "linear-gradient(180deg, oklch(0.3 0 0) 0%, oklch(0.23 0 0) 100%)",
  "--text-shadow-pressed": "0 1px 1px rgba(0, 0, 0, 0.5)",
  "--shadow-s": "var(--shadow-sm)",
  "--shadow-m": "var(--shadow-md)",
  "--shadow-l": "var(--shadow-lg)",
  "--shadow-button": "var(--shadow-pill)",
  "--shadow-button-hover": "var(--shadow-pill-hover)",
  "--shadow-primary": "var(--shadow-pill)"
}

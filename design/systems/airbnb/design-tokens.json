{
  "--background": "#FFFFFF",
  "--foreground": "#222222",
  "--card": "#FFFFFF",
  "--card-foreground": "#222222",
  "--popover": "#FFFFFF",
  "--popover-foreground": "#222222",
  "--primary": "#FF385C",
  "--primary-foreground": "#FFFFFF",
  "--secondary": "#222222",
  "--secondary-foreground": "#FFFFFF",
  "--muted": "#F7F7F7",
  "--muted-foreground": "#6A6A6A",
  "--accent": "#F7F7F7",
  "--accent-foreground": "#222222",
  "--destructive": "#C13515",
  "--destructive-foreground": "#FFFFFF",
  "--border": "#DDDDDD",
  "--input": "#F7F7F7",
  "--ring": "#222222",
  "--radius": "0.75rem",
  "--rausch-gradient": "radial-gradient(\n    circle at center,\n    #FF385C 0%,\n    #E61E4D 27.5%,\n    #E31C5F 40%,\n    #D70466 57.5%,\n    #BD1E59 75%,\n    #BD1E59 100%\n  )",
  "--shadow-2xs": "0 1px 2px rgba(0,0,0,0.04)",
  "--shadow-xs": "0 1px 2px rgba(0,0,0,0.06)",
  "--shadow-sm": "0 1px 2px rgba(0,0,0,0.08), 0 4px 12px rgba(0,0,0,0.05)",
  "--shadow": "0 2px 4px rgba(0,0,0,0.08), 0 4px 12px rgba(0,0,0,0.08)",
  "--shadow-md": "0 2px 8px rgba(0,0,0,0.08), 0 6px 20px rgba(0,0,0,0.06)",
  "--shadow-lg": "0 6px 20px rgba(0,0,0,0.2)",
  "--shadow-xl": "0 6px 20px rgba(0,0,0,0.2), 0 0 0 1px rgba(0,0,0,0.04)"
}

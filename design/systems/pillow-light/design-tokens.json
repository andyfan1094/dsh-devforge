  "--shadow-pillow-primary-hover": "inset 0 1px 0 0 rgba(255, 255, 255, 0.32),\n    inset 0 -2px 0 0 rgba(0, 0, 0, 0.20),\n    0 2px 2px 0 rgba(15, 23, 42, 0.10),\n    0 8px 18px -3px rgba(30, 102, 255, 0.45)",
